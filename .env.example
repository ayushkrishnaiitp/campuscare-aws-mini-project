NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://campuscare:campuscare_dev@localhost:5432/campuscare
SESSION_SECRET=replace-with-a-long-random-secret-before-production
UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads
# For UPLOAD_DRIVER=s3 (bucket must already exist; no provisioning is performed):
AWS_REGION=us-east-1
S3_BUCKET=
# Credentials should come from the AWS SDK default credential chain, never from committed files.
